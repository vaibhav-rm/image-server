rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is whitelisted/invited
    // We assume a 'users' collection where the document ID is the User UID
    // OR an 'invites' collection where the document ID is the Email (sanitized)
    // For simplicity in this MVP, we'll check if the user exists in 'users' collection.
    function isWhitelisted() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
      // return isAuthenticated();
    }

    // Users collection: specific user can read/write their own doc
    match /users/{userId} {
      allow read: if isWhitelisted();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Memories: Only whitelisted users can read/write
    match /memories/{memoryId} {
      allow read, create: if isWhitelisted();
      allow update, delete: if isWhitelisted() && resource.data.uploadedBy == request.auth.uid;
      
      // Subcollection: Comments
      match /comments/{commentId} {
        allow read, write: if isWhitelisted();
      }
    }
    
    // Invites collection (for admin use or checking)
    match /invites/{email} {
        allow read: if isAuthenticated();
    }
  }
}
